# Node 22 LTS and npm 10.9.2. ConfigModule reads .env; prefer injected production variables.
# Template only: never copy local database credentials or commit populated values.
NODE_ENV=production
PORT_API=3007
PORT_BATCH=3008
# Choose an intentional production database on a transaction-capable deployment.
MONGO_PROD=mongodb+srv://<username>:<password>@<cluster>/<database>
# Development only; not selected by the production commands.
# MONGO_DEV=mongodb://127.0.0.1:27017/<development-database>?replicaSet=<replica-set>
# Generate two independent random secrets of at least 32 bytes; empty values fail startup.
SECRET_TOKEN=
SECRET_REFRESH_TOKEN=
# Exact HTTPS frontend origin(s), comma-separated, without paths or trailing slashes.
AUTH_ALLOWED_ORIGINS=https://gymflow.example
# Required in production: absolute directory backed by a persistent volume, writable by the API user.
# Same filesystem must support hard links between .tmp and member/article/program. Public URLs stay /uploads.
UPLOAD_ROOT=/var/lib/gymflow/uploads
