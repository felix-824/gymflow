# Node 22.x and npm 10.9.2. These are RUNTIME values; ConfigModule reads .env in the process CWD.
# Prefer injected production configuration. Both production start scripts force NODE_ENV=production.
# Template only: never copy local database credentials or commit populated values.
NODE_ENV=production
# Set explicitly to avoid the application's 3000 fallback conflicting with the frontend.
PORT_API=3007
PORT_BATCH=3008
# API + batch: same intentional application DB, writable replica set/mongos, logical sessions/transactions.
# Primary reads and acknowledged writes are required. Startup verifies nine critical index contracts.
MONGO_PROD=mongodb+srv://<username>:<password>@<cluster>/<database>
# Development only; not selected by the production commands.
# MONGO_DEV=mongodb://127.0.0.1:27017/<development-database>?replicaSet=<replica-set>
# API only: generate two different independent random secrets, each at least 32 UTF-8 bytes.
# Keep values in a secret store; empty/short/equal values fail startup.
SECRET_TOKEN=
SECRET_REFRESH_TOKEN=
# API only: exact HTTPS frontend origin(s), comma-separated, without paths/trailing slashes; no wildcard.
AUTH_ALLOWED_ORIGINS=https://gymflow.example
# API only: required absolute application directory backed by a persistent volume, writable by the API user.
# Same filesystem must support hard links between .tmp and member/article/program. Public URLs stay /uploads.
UPLOAD_ROOT=/var/lib/gymflow/uploads
